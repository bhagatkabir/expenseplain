APP_NAME=expenseplain-api
ENVIRONMENT=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=expenseplain
MYSQL_PASSWORD=
MYSQL_DATABASE=expenseplain

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
VERIFICATION_TOKEN_TTL_MINUTES=15

# --- Signup OTP ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMTP ---
# Leave SMTP_HOST empty in development: OTP emails are written to the server log
# instead of being sent. For Gmail use smtp.gmail.com:587 with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@expenseplain.local
SMTP_STARTTLS=true
